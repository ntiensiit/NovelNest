@model ArticleDeleteViewModel

@{
    ViewBag.Title = "Delete Article";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <img class="card-img-top" src="@Model.ImageUrl" alt="Article Image" style="max-width: 200px; height: auto;">
                    <h2 class="card-title" style="margin-top: 15px;">@Model.Title</h2>
                    <h5 class="card-title" style="margin-top: 15px;">Views: @Model.ViewsCount</h5>
                    <p class="text-danger mt-3">Are you sure you want to delete this article?</p>
                </div>
                <div class="card-footer d-flex justify-content-center">
                    <form asp-action="DeleteArticleConfirmed" method="post" class="col-12">
                        <input type="hidden" asp-for="Id" />
                        <a asp-controller="Article" asp-action="Details" asp-route-id="@Model.Id" asp-route-information="@Model.GetArticleInformation()" class="btn btn-warning mb-1 w-100 p-3 fw-bold">Back</a>
                        <button type="submit" class="btn btn-danger mb-1 w-100 p-3 fw-bold">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>