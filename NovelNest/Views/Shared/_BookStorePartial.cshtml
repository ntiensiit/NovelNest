@model BookStoreServiceModel

@{
    CultureInfo.CurrentCulture = new System.Globalization.CultureInfo("en-EN");
}

<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
    <div class="card h-100 text-center">
        <img class="card-img-top" src="@Model.ImageUrl" alt="Bookstore Image">
        <div class="card-body">
            <h3 class="card-title"><strong>@Model.Name</strong></h3>
            <p class="card-text"><strong>Location:</strong> @Model.Location</p>
            <p class="card-text"><strong>Opens:</strong> @Model.OpeningTime.ToString("HH:mm")</p>
            <p class="card-text"><strong>Closes:</strong> @Model.ClosingTime.ToString("HH:mm")</p>
            <p class="card-text">
                <strong>Currently:</strong>
                @if (Model.Status == true)
                {
                    <span class="text-success"><strong>Open</strong></span>
                }
                else
                {
                    <span class="text-danger"><strong>Closed</strong></span>
                }
            </p>
        </div>
        <a asp-controller="BookStore" asp-action="Details" asp-route-information="@Model.GetInformation()" asp-route-id="@Model.Id" class="btn btn-warning mb-1 w-100 p-3 fw-bold">View more</a>

        <a asp-controller="BookStore" asp-action="AllBooks" asp-route-id="@Model.Id" class="btn btn-success mb-1 w-100 p-3 fw-bold">View all available books</a>
    </div>
</div>