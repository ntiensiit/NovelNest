@inject UserManager<ApplicationUser> UserManager
@model BookReviewServiceModel

@{
    var user = await UserManager.FindByIdAsync(Model.UserId);
    var currentUserName = user?.FirstName + " " + user.LastName;
}

<div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
    <div><strong>@currentUserName</strong></div>
    <div>
         <strong>Rating: </strong>
         @for (int i = 1; i <= Model.Rate; i++)
         {
            <span style="color: gold; font-size: 15px;">⭐</span>
         }
         (@Model.Rate of 10)
    </div>
    <div><strong>Title:</strong> @Model.Title</div>
    <div><strong>Description:</strong> @(Model.Description?.Length <= 300 ? Model.Description : Model.Description.Substring(0, 300) + (Model.Description.Length > 300 ? "..." : ""))</div>

    <div class="d-flex justify-content-center mt-3">
        @if (Model.Description.Length > 300)
        {
            <a asp-controller="Book" asp-action="BookReviewDetails" asp-route-id="@Model.Id" class="btn btn-warning px-2 fw-bold me-2">View Full Review</a>
        }

        @if (Model.UserId == UserManager.GetUserId(User) && User.IsAdmin())
        {
            <a asp-controller="Book" asp-action="EditBookReview" asp-route-id="@Model.Id" class="btn btn-secondary px-2 fw-bold me-2">Edit</a>
            <a asp-controller="Book" asp-action="DeleteBookReview" asp-route-id="@Model.Id" class="btn btn-danger px-2 fw-bold">Delete</a>
        }
        else if (User.IsAdmin())
        {
            <a asp-controller="Book" asp-action="DeleteBookReview" asp-route-id="@Model.Id" class="btn btn-danger px-2 fw-bold">Delete</a>
        }
        else if (Model.UserId == UserManager.GetUserId(User))
        {
            <a asp-controller="Book" asp-action="EditBookReview" asp-route-id="@Model.Id" class="btn btn-secondary px-2 fw-bold me-2">Edit</a>
            <a asp-controller="Book" asp-action="DeleteBookReview" asp-route-id="@Model.Id" class="btn btn-danger px-2 fw-bold">Delete</a>
        }
    </div>
</div>
