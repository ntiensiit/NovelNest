@model BookViewModel

@{
    ViewBag.Title = "Details";
}
<h2 class="text-center mt-4 mb-3">@ViewBag.Title</h2>
<hr />

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-4 text-center">
            <img src="@Model.ImageUrl" class="img-fluid" alt="Book Image" style="max-width: 100%;" />
        </div>
        <div class="col-md-8">
            <h4>@Model.Title</h4>
            <p><strong>Author:</strong> @Model.Author</p>
            <p><strong>Genre:</strong> @Model.Genre</p>
            <p><strong>Summary:</strong> @Model.Description</p>
            <p><strong>Pages:</strong> @Model.Pages</p>
            <p><strong>Publisher:</strong> @Model.PublishingHouse</p>
            <p><strong>Year Published:</strong> @Model.YearPublished</p>
            <p><strong>Cover Type:</strong> @Model.CoverType</p>
            <p><strong>Price:</strong> @Model.Price BGN</p>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-1">
        <a asp-controller="Book" asp-action="Mine" asp-route-id="@User.Id()" class="btn btn-warning mb-1 me-1 me-md-2 w-100 p-3 fw-bold">Back to My Books</a>
        <a asp-controller="Book" asp-action="CurrentlyReading" asp-route-id="@Model.Id" class="btn btn-warning mb-1 w-100 p-3 fw-bold">Back to "Currently Reading"</a>
    </div>

    <div class="d-flex justify-content-center mt-1">
        <a asp-controller="Book" asp-action="AddCurrentlyReading" asp-route-id="@Model.Id" class="btn btn-success mb-1 me-1 me-md-2 w-100 p-3 fw-bold">Move to "Currently Reading"</a>
        <a asp-controller="Book" asp-action="AddRead" asp-route-id="@Model.Id" class="btn btn-success mb-1 w-100 p-3 fw-bold">Move to "Read"</a>
    </div>

    <div class="d-flex justify-content-center mt-1">
        <a asp-controller="Book" asp-action="AddReview" asp-route-id="@Model.Id" class="btn btn-secondary mb-1 me-1 me-md-2 w-100 p-3 fw-bold">Add Review</a>
        <a asp-controller="Book" asp-action="AllReviews" asp-route-id="@Model.Id" class="btn btn-secondary mb-1 w-100 p-3 fw-bold">View All Reviews</a>
    </div>

    <div class="text-center mt-1">
        <a asp-controller="Book" asp-action="AddToCart" class="btn btn-primary mb-2 w-100 p-3 fw-bold">Add to Cart</a>
        <a asp-controller="Book" asp-action="RemoveWantToRead" asp-route-id="@Model.Id" class="btn btn-danger mb-2 w-100 p-3 fw-bold">Remove</a>
    </div>
</div>