@model EventDetailsViewModel
@inject IPublisherService publisherService

@{
    ViewBag.Title = "Events";
    CultureInfo.CurrentCulture = new System.Globalization.CultureInfo("en-EN");
}

<div class="container text-center mt-5">
    <div class="card">
        <div class="card-body">
            <img src="@Model.ImageUrl" alt="Article Image" class="img-fluid mb-3" />
            <h2 class="card-title">@Model.Topic</h2>
            <h4 class="card-title">@Model.Location</h4>
            <p class="card-text"><strong>Start:</strong> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="card-text"><strong>End:</strong> @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="card-text"><strong>Available Seats:</strong> @Model.Seats</p>
            <p class="card-text"><strong>Ticket Price:</strong> @Model.TicketPrice BGN</p>

            <div class="container-sm">
                <p>@Html.DisplayFor(model => model.Description)</p>
            </div>

            <div class="text-center mt-1">
                <a asp-controller="Event" asp-action="All" class="btn btn-warning mb-2 w-100 p-3 fw-bold">Back to All Events</a>
                @if (Model.Seats > 0)
                {
                    <a asp-controller="Cart" asp-action="AddEvent" class="btn btn-primary mb-2 w-100 p-3 fw-bold">Add Ticket to Cart</a>
                }
                
            </div>

            @if (await publisherService.ExistsByUserIdAsync(User.Id()))
            {
                <hr />
                <div class="d-flex justify-content-center mt-1">
                    <a asp-controller="Publisher" asp-action="EditEvent" asp-route-id="@Model.Id" class="btn btn-success mb-1 me-1 me-md-2 w-100 p-3 fw-bold">Edit</a>
                    <a asp-controller="Publisher" asp-action="DeleteEvent" asp-route-id="@Model.Id" class="btn btn-danger mb-1 me-1 me-md-2 w-100 p-3 fw-bold">Delete</a>
                </div>
            }
        </div>
    </div>
</div>